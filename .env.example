# ---------------------------------------------------------------------------
# GameNet environment. Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# Role of this process: cloud | edge
GAMENET_ROLE=edge

# --- Shared ---
GAMENET_ENV=dev
DJANGO_SECRET_KEY=change-me-to-50-random-chars
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Local dev ports (used by dev/env.sh and the proof runner) ---
PG_PORT=55432
REDIS_PORT=56379
CLOUD_PORT=18443
EDGE_PORT=19443

# --- Database (PostgreSQL 18) ---
# Edge and cloud use the same schema. SQLite is supported only for tests/dev.
# dev/run_*.sh override this per role; keep it as a sane direct-run default.
DATABASE_URL=postgresql://gamenet:gamenet@127.0.0.1:55432/gamenet_edge
# DATABASE_URL=postgresql://gamenet:gamenet@127.0.0.1:55432/gamenet_cloud

# --- Channel layer: memory (edge, single worker) | redis (cloud) ---
CHANNEL_LAYER=memory
REDIS_URL=redis://127.0.0.1:56379/0

# --- Edge node ---
EDGE_NAME="Main Gaming Floor"
EDGE_LAN_BIND=0.0.0.0
EDGE_LAN_PORT=19443
# Cloud endpoint the edge dials out to
CLOUD_BASE_URL=https://127.0.0.1:18443
CLOUD_CA_BUNDLE=dev/certs/ca.pem
# Where the edge keeps its cloud credentials (DPAPI-protected on Windows)
EDGE_CREDENTIALS_FILE=.artifacts/edge-credentials.json
EDGE_SYNC_INTERVAL_SECONDS=2
EDGE_HEARTBEAT_SECONDS=15

# --- Pricing and credit defaults (integer Toman) ---
DEFAULT_HOURLY_RATE=40000
DEFAULT_CREDIT_LIMIT=60000

# --- Dashboard administrator (created by dev/migrate.sh or the proof runner) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-running
ADMIN_EMAIL=admin@example.com

# --- Device protocol ---
DEVICE_HEARTBEAT_SECONDS=10
DEVICE_OFFLINE_AFTER_MISSED=3
CLIENT_PAIRING_HOST=127.0.0.1:19443

# --- Client build/runtime (client/.env) ---
# VITE_HUB_URL=wss://127.0.0.1:19443
