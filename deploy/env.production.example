# GameNet cloud production environment.
# Copy to /opt/gamenet/.env, replace every __VALUE__, chmod 600.
GAMENET_ROLE=cloud
GAMENET_ENV=production
GAMENET_LOG_LEVEL=INFO

DJANGO_SECRET_KEY=__GENERATE_50_RANDOM_CHARS__
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=gamenet.hammasjedy.ir,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://gamenet.hammasjedy.ir
DJANGO_BEHIND_PROXY=1
DJANGO_USE_X_FORWARDED_HOST=1
DJANGO_SECURE_COOKIES=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_STATIC_ROOT=/opt/gamenet/static

DATABASE_URL=postgresql://gamenet:__DB_PASSWORD__@127.0.0.1:5432/gamenet_cloud
CHANNEL_LAYER=redis
REDIS_URL=redis://127.0.0.1:6379/0

DEFAULT_HOURLY_RATE=40000
DEFAULT_CREDIT_LIMIT=60000
DEVICE_COMMAND_TTL_SECONDS=120
SYNC_BATCH_SIZE=100

ADMIN_USERNAME=admin
ADMIN_PASSWORD=__ADMIN_PASSWORD__
ADMIN_EMAIL=admin@hammasjedy.ir
